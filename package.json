{
  "name": "@cp7553479/image-cli",
  "version": "0.1.3",
  "description": "Unified image generation CLI with provider plugins and shared configuration.",
  "type": "module",
  "bin": {
    "image": "bin/image.js"
  },
  "files": [
    "bin",
    "dist",
    "docs",
    "LICENSE",
    "README.md",
    "README_CN.md",
    "plugins/PLUGINS_README.md",
    "SPEC.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run check && npm run lint && npm test && npm run build",
    "prepack": "npm run verify",
    "lint": "eslint \"src/**/*.ts\""
  },
  "keywords": [
    "image",
    "cli",
    "openai",
    "gemini",
    "bailian",
    "dashscope",
    "volcengine",
    "minimax"
  ],
  "author": "cp7553479",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cp7553479/image-cli.git"
  },
  "homepage": "https://github.com/cp7553479/image-cli",
  "bugs": {
    "url": "https://github.com/cp7553479/image-cli/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.6.2",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^9.36.0",
    "eslint-plugin-jsdoc": "^50.6.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
